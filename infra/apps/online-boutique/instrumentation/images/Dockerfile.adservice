FROM alpine:3.22 AS java-agent

ARG OTEL_JAVA_AGENT_VERSION=2.34.0
RUN apk add --no-cache ca-certificates curl \
    && curl -fsSL \
      "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_JAVA_AGENT_VERSION}/opentelemetry-javaagent.jar" \
      -o /opentelemetry-javaagent.jar \
    && echo "da44154cea128257779c8a782b9651fd7c0c6aa177cd3810f9a867ac8509555d  /opentelemetry-javaagent.jar" \
      | sha256sum -c -

FROM us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo/adservice:v0.10.7

COPY --from=java-agent /opentelemetry-javaagent.jar /otel/opentelemetry-javaagent.jar
ENV JAVA_TOOL_OPTIONS="-javaagent:/otel/opentelemetry-javaagent.jar"
